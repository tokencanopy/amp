# apps/amp — local v0 developer prototype.
# Copy to .env and adjust. Every default is the safe local one.

# Loopback only. This app launches processes and has no authentication of its
# own; binding it to a routable address exposes that to your network.
AMP_HOST=127.0.0.1
AMP_PORT=4321

# SQLite file. ":memory:" works for throwaway runs.
AMP_DB=./data/amp.db

# Default working directory offered to a launched agent. The agent's own
# sandbox and approval rules still apply inside it.
AMP_WORKSPACE=.

# Overrides and extra ACP agents (see agents.config.example.json).
AMP_AGENTS_CONFIG=./agents.config.json

# Hand the agent the meeting MCP server when its ACP session is created.
AMP_ENABLE_MCP=true

# How long a permission request waits for a human before it is DENIED.
# Silence is never consent, so this timeout refuses rather than allows.
AMP_PERMISSION_TIMEOUT_MS=120000

# Turn limits. Idle resets on any agent output; total is the wall-clock cap.
AMP_IDLE_TIMEOUT_MS=300000
AMP_TOTAL_TIMEOUT_MS=1800000

# Allow launching a command supplied in the request body ("generic" agent).
# Off by default: the browser must not be able to name an arbitrary
# executable for the server to run.
AMP_ALLOW_GENERIC=false

AMP_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Recall.ai meeting provider (optional). Leave unset to use the simulator.
#
# All three of KEY, WEBHOOK_BASE_URL and WEBHOOK_SECRET must be set before the
# provider is offered at all — a half-configured bot is worse than none.
#
# NOTE: the wire format in src/providers/recall/wire.ts was written without
# access to Recall's API or docs. Verify it against https://docs.recall.ai
# before the first live run.
# ---------------------------------------------------------------------------

# AMP_RECALL_API_KEY=
# AMP_RECALL_REGION=us-west-2

# Where Recall can reach THIS server. In development that is a tunnel
# (ngrok, cloudflared); it must be public, because Recall calls it.
# AMP_RECALL_WEBHOOK_BASE_URL=https://your-tunnel.ngrok.app

# Required. Recall's real-time webhooks are unauthenticated POSTs to a public
# URL, so this secret is the only thing stopping anyone who finds the URL from
# writing into a live meeting's transcript — the one input the agent trusts.
# AMP_RECALL_WEBHOOK_SECRET=

# Optional, and how the agent gets a voice. Recall streams this page's audio
# and video into the call; `public/speaker.html` in this app is that page, so
# point this at your tunnel's copy of it. Leave it unset and the agent is
# text-only — it posts to the meeting's chat instead of talking.
#
# Note it must be the PUBLIC url, not 127.0.0.1: the browser that loads it runs
# in Recall's infrastructure, not on this machine. Recall's Output Media always
# carries video, so the agent is a visible tile in the call either way.
# AMP_RECALL_SPEAKER_URL=https://your-tunnel.example/speaker.html

# Optional. A macOS `say` voice for the agent — `say -v '?'` lists them.
# The audio is synthesized on THIS machine and fetched by the speaker page,
# because a headless browser has no speechSynthesis voices and would stream
# silence. An unknown name falls back to the system default rather than
# failing, so a typo costs you the wrong voice, never a mute agent.
# AMP_RECALL_SPEAKER_VOICE=Samantha

# AMP_RECALL_BOT_NAME=AMP cofounder
